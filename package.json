{
  "name": "safesurf-suite",
  "version": "1.0.0",
  "type": "module",
  "description": "SafeSurf - Adult content blocker, SafeSearch enforcer, MERN backend, and React dashboard",
  "scripts": {
    "clean-domains": "node scripts/clean-domains.js",
    "download-models": "node scripts/download-nsfw-assets.js",
    "build:blocklist": "node scripts/build-blocklist.js",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "dashboard": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "info": "echo \"SafeSurf Suite: Load unpacked extension at chrome://extensions | Backend in server | Dashboard in dashboard\""
  },
  "keywords": [
    "chrome-extension",
    "safesurf",
    "manifest-v3",
    "content-blocker",
    "mern",
    "react"
  ],
  "author": "",
  "license": "MIT"
}
